--=============================================================== formatting helpers
local function formatBig(n)
	if type(n) ~= "number" then return tostring(n) end
	if n == 0 then return "0" end
	local units = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No" }
	local i = 1
	local v = n
	while math.abs(v) >= 1000 and i < #units do v = v / 1000; i += 1 end
	if i == 1 then return tostring(math.floor(v + 0.5)) end
	return string.format("%.2f%s", v, units[i])
end

local function formatTime(sec)
	sec = tonumber(sec) or 0
	if sec <= 0 then return "—" end
	if sec < 60 then return sec .. "s" end
	if sec < 3600 then return string.format("%dm %ds", sec // 60, sec % 60) end
	local h = sec // 3600
	return string.format("%dh %dm", h, (sec % 3600) // 60)
end

local function myRoot()
