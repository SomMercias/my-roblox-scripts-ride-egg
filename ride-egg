--=============================================================== lifecycle
local running = true
local conns = {}

local function stop()
	running = false
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	disableNoclip()
	clearAllEsp()
	pcall(function() espFolder:Destroy() end)
	pcall(function() gui:Destroy() end)
	_G.__EggESP_Stop = nil
end
_G.__EggESP_Stop = stop
btnClose.MouseButton1Click:Connect(stop)

-- Reset noclip bookkeeping on respawn (the loop re-applies to the new body).
table.insert(conns, LocalPlayer.CharacterAdded:Connect(function() noclipOriginals = {} end))

table.insert(conns, UserInputService.InputBegan:Connect(function(i, gpe)
	if gpe then return end
	if i.KeyCode == Enum.KeyCode.RightAlt then
		main.Visible = not main.Visible
		pill.Visible = not main.Visible
	elseif i.KeyCode == Enum.KeyCode.G and S.warpHotkey then
		local ok, res = warpToNearest()
		if ok then notify("Warped to nearest: " .. res.name, rarityColor(res.data and res.data.Rarity))
		else notify("Warp failed: " .. tostring(res), Color3.fromRGB(230, 85, 85)) end
	elseif i.KeyCode == Enum.KeyCode.H and S.homeHotkey then
		local ok, res = warpHome()
		if ok then notify("🏠 Warped home", Color3.fromRGB(70, 150, 255))
		else notify("Home failed: " .. tostring(res), Color3.fromRGB(230, 85, 85)) end
	elseif i.KeyCode == Enum.KeyCode.N and S.noclipHotkey then
		S.noclip = not S.noclip
		if S.noclip then enableNoclip() else disableNoclip() end
		notify(S.noclip and "Noclip ON" or "Noclip OFF", S.noclip and COL.accent or COL.sub)
	end
end))

table.insert(conns, RunService.RenderStepped:Connect(onRender))

-- Watch ActiveEggs for add/remove so ESP + list stay live.
local function hookFolder()
	local f = getActiveEggsFolder()
	if not f then return end
	table.insert(conns, f.ChildAdded:Connect(function() task.defer(reconcile) end))
	table.insert(conns, f.ChildRemoved:Connect(function(child) destroyEsp(child) end))
end
hookFolder()

-- Periodic reconcile + live list refresh.
task.spawn(function()
	while running do
		pcall(reconcile)
		pcall(refreshLive)
		local f = getActiveEggsFolder()
		subTitle.Text = f and ("read-only · source: " .. f:GetFullName()) or "read-only · waiting for ActiveEggs…"
		task.wait(1)
	end
end)

-- Auto-warp home while holding an egg (fires once per pickup, 2s cooldown).
task.spawn(function()
	local wasHolding, lastWarp = false, 0
	while running do
		if S.autoHome then
			local holding = heldEggTool() ~= nil
			if holding and not wasHolding and (os.clock() - lastWarp) > 2 then
				lastWarp = os.clock()
				local ok = warpHome()
				if ok then notify("🏠 Auto-home (holding egg)", Color3.fromRGB(70, 150, 255)) end
			end
			wasHolding = holding
		else
			wasHolding = false
		end
		task.wait(0.25)
	end
end)

