-- Is the local character currently holding an egg (equipped Tool)?
-- Returns the tool + egg display name, or nil.
local function heldEggTool()
	local ch = LocalPlayer.Character
	if not ch then return nil end
	for _, t in ipairs(ch:GetChildren()) do
		if t:IsA("Tool") then
			local eggName = t:GetAttribute("Egg")
			local isEgg = (eggName ~= nil)
				or (t:GetAttribute("EggKey") ~= nil)
				or (t.HasTag and t:HasTag("Egg"))
				or (EggData[t.Name] ~= nil)
			if isEgg then
				return t, (eggName or t.Name)
			end
		end
	end
	return nil
end

-- Locate the local player's own plot (uses the game's own service, then falls
-- back to scanning workspace.Plots by owner attribute / Owner ObjectValue).
local function findMyPlot()
	local gs = ReplicatedStorage:FindFirstChild("GameServices")
	local genMod = gs and gs:FindFirstChild("General")
	if genMod and genMod:IsA("ModuleScript") then
		local ok, gen = pcall(require, genMod)
		if ok and type(gen) == "table" and gen.GetPlot then
			local ok2, plot = pcall(function() return gen:GetPlot(LocalPlayer) end)
			if ok2 and typeof(plot) == "Instance" then return plot end
		end
	end
	local plots = workspace:FindFirstChild("Plots")
	if not plots then return nil end
	for _, plot in ipairs(plots:GetChildren()) do
		if plot:GetAttribute("OwnerUserId") == LocalPlayer.UserId then return plot end
		local data = plot:FindFirstChild("Data")
		local owner = (data and data:FindFirstChild("Owner")) or plot:FindFirstChild("Owner")
		if owner and owner:IsA("ObjectValue") and owner.Value == LocalPlayer then return plot end
	end
	return nil
end

-- CFrame just above the home baseplate.
local function getHomeCFrame()
	local plot = findMyPlot()
	if not plot then return nil, nil end
	local base = plot:FindFirstChild("Baseplate") or plot:FindFirstChildWhichIsA("BasePart")
	if not base then return nil, plot end
	return base.CFrame * CFrame.new(0, S.warpHeight, 0), plot
end

-- Warp the whole character (keeps the held egg) home. Returns ok, plot|err.
local function warpHome()
	local ch = LocalPlayer.Character
	if not ch then return false, "no character" end
	local cf, plot = getHomeCFrame()
	if not cf then return false, "home plot not found" end
	local hum = ch:FindFirstChildOfClass("Humanoid")
	if hum and hum.Sit then hum.Sit = false end
	ch:PivotTo(cf)                       -- PivotTo moves the character + held tool
	return true, plot
end

--=============================================================== noclip (local movement)
-- Client-side only: clears collision on the local character's own parts so you
-- can walk through walls. Fires no remotes and affects only your own character.
S.noclip = false
S.noclipHotkey = false
local noclipConn
local noclipOriginals = {}   -- [part] = original CanCollide, to restore on disable
local function enableNoclip()
	if noclipConn then return end
	noclipConn = RunService.Stepped:Connect(function()
		if not S.noclip then return end
		local ch = LocalPlayer.Character
		if not ch then return end
		for _, p in ipairs(ch:GetDescendants()) do
			if p:IsA("BasePart") and p.CanCollide then
				if noclipOriginals[p] == nil then noclipOriginals[p] = true end
				p.CanCollide = false
			end
		end
	end)
end
local function disableNoclip()
	if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
	for p, orig in pairs(noclipOriginals) do
		if typeof(p) == "Instance" and p.Parent then pcall(function() p.CanCollide = orig end) end
	end
	noclipOriginals = {}
end

