local function settingSlider(order, label, min, max, key, suffix)
	local card = mk("Frame", { BackgroundColor3 = COL.card, Size = UDim2.new(1, -2, 0, 52), BorderSizePixel = 0, LayoutOrder = order }, pageSet)
