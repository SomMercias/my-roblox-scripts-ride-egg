-- Should this egg be shown given filters?
local function passesFilter(name, data, child)
	if not data then return true end -- unknown egg: show anyway
	if rarityRank(data.Rarity) < S.minRarity then return false end
	if S.hidePrivate then
		local priv = child:GetAttribute("PrivateTo")
		if priv and priv ~= LocalPlayer.UserId then return false end
	end
	return true
end

-- Read the world position for a marker (attribute first, fall back to part).
local function markerPosition(child)
	local p = child:GetAttribute("Position")
	if typeof(p) == "Vector3" then return p end
	if child:IsA("BasePart") then return child.Position end
	if child:IsA("Model") and child.PrimaryPart then return child.PrimaryPart.Position end
	local cf = child:GetAttribute("SpawnCFrame")
	if typeof(cf) == "CFrame" then return cf.Position end
	return nil
end

-- Reconcile ESP objects against the current ActiveEggs children.
local function reconcile()
	local folder = getActiveEggsFolder()
	if not folder then clearAllEsp() return end

	local seen = {}
	for _, child in ipairs(folder:GetChildren()) do
		local name = child:GetAttribute("Egg")
		if name then
			seen[child] = true
			local data = eggInfo(name)
			local pos = markerPosition(child)
			local show = S.espEnabled and pos and passesFilter(name, data, child)
			if show then
				local o = espObjects[child]
				if not o then o = buildEsp(child, name, data, pos) end
				o.part.CFrame = CFrame.new(pos)
			else
				destroyEsp(child)
			end
		end
	end
	-- remove ESP for markers that no longer exist / filtered out
	for child in pairs(espObjects) do
		if not seen[child] then destroyEsp(child) end
	end
end

-- Per-frame: update distance text + label visibility, throttled.
local lastUpd = 0
local function onRender()
	if not S.espEnabled then return end
	local now = os.clock()
	if now - lastUpd < 0.1 then return end
	lastUpd = now
	local root = myRoot()
	local cam = workspace.CurrentCamera
	local origin = (root and root.Position) or (cam and cam.CFrame.Position)
	for child, o in pairs(espObjects) do
		if o.part and o.part.Parent then
			local dist = origin and (o.part.Position - origin).Magnitude or 0
			o.nameLbl.Visible = S.showNames
			o.statLbl.Visible = S.showStats
			o.distLbl.Visible = S.showDistance
			o.part.Transparency = S.showMarker and 0.35 or 1
			if S.showStats then
				local d = o.data or {}
				local mut = child:GetAttribute("Mutation") or child:GetAttribute("SpawnMutation")
				local price = d.SellPrice and ("$" .. formatBig(d.SellPrice)) or "$?"
				local luck = d.Luck and ("· Luck " .. formatBig(d.Luck)) or ""
				o.statLbl.Text = (d.Rarity or "?") .. " · " .. price .. " " .. luck
					.. (mut and ("  ⟡" .. tostring(mut)) or "")
			end
			if S.showDistance then
				o.distLbl.Text = string.format("%.0f studs", dist)
			end
			-- distance cull
			local visible = (S.maxDistance == 0) or (dist <= S.maxDistance)
			o.bb.Enabled = visible
		end
	end
end

--=============================================================== live snapshot for UI
-- Returns grouped list: { {name, rarity, count, price, luck, growth, nearest} , ... }
local function snapshotActive()
	local folder = getActiveEggsFolder()
	local groups, order = {}, {}
	local total = 0
	local root = myRoot()
	local origin = root and root.Position
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			local name = child:GetAttribute("Egg")
			if name then
				if S.hidePrivate then
					local priv = child:GetAttribute("PrivateTo")
					if priv and priv ~= LocalPlayer.UserId then name = nil end
				end
			end
			if name then
				total += 1
				local g = groups[name]
				if not g then
					local d = eggInfo(name) or {}
					g = { name = name, rarity = d.Rarity or "?", price = d.SellPrice,
						luck = d.Luck, growth = d.GrowthTime, count = 0, nearest = math.huge }
					groups[name] = g
					table.insert(order, g)
				end
				g.count += 1
				local pos = markerPosition(child)
				if pos and origin then
					local dd = (pos - origin).Magnitude
					if dd < g.nearest then g.nearest = dd end
				end
			end
		end
	end
	table.sort(order, function(a, b)
		local ra, rb = rarityRank(a.rarity), rarityRank(b.rarity)
		if ra ~= rb then return ra > rb end       -- rarest first
		return (a.luck or 0) > (b.luck or 0)
	end)
	return order, total, (folder ~= nil)
end

--=============================================================== warp / teleport
-- Teleporting is a local movement action (sets HumanoidRootPart CFrame). It does
-- NOT fire any remote. Whether the server keeps you there depends on its own
-- movement validation (see the MOV-007 test in the main suite).
S.warpHeight = 6      -- studs above the egg to land on
S.warpHotkey = false  -- press G to warp to nearest egg

-- Flat list of every currently-spawned egg (respecting the private filter).
local function collectEggInstances()
	local folder = getActiveEggsFolder()
	local list = {}
	if not folder then return list end
	local root = myRoot()
	local origin = root and root.Position
	for _, child in ipairs(folder:GetChildren()) do
		local name = child:GetAttribute("Egg")
		if name and S.hidePrivate then
			local priv = child:GetAttribute("PrivateTo")
			if priv and priv ~= LocalPlayer.UserId then name = nil end
		end
		if name then
			local pos = markerPosition(child)
			if pos then
				local dist = origin and (pos - origin).Magnitude or math.huge
				table.insert(list, { inst = child, name = name, data = eggInfo(name), pos = pos, dist = dist })
			end
		end
	end
	return list
end

local function warpToPosition(pos)
	local ch = LocalPlayer.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not root then return false, "no character" end
	if hum and hum.Sit then hum.Sit = false end          -- stand up if riding/seated
	root.CFrame = CFrame.new(pos + Vector3.new(0, S.warpHeight, 0))
	return true
end

-- Warp to the nearest egg (optionally of a specific type). Returns ok, entry|err.
local function warpToNearest(filterName)
	local best
	for _, e in ipairs(collectEggInstances()) do
		if (not filterName) or e.name == filterName then
			if not best or e.dist < best.dist then best = e end
		end
	end
	if not best then return false, "no matching egg spawned" end
	local ok, err = warpToPosition(best.pos)
	if not ok then return false, err end
	return true, best
end

-- Warp to the rarest egg currently spawned (ties broken by nearest).
local function warpToRarest()
	local best, bestRank
	for _, e in ipairs(collectEggInstances()) do
		local rank = rarityRank(e.data and e.data.Rarity)
		if (not best) or rank > bestRank or (rank == bestRank and e.dist < best.dist) then
			best, bestRank = e, rank
		end
	end
	if not best then return false, "no egg spawned" end
	local ok, err = warpToPosition(best.pos)
	if not ok then return false, err end
	return true, best
end

