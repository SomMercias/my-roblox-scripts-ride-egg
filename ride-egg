local function refreshLive()
	-- clear old rows + empty-state label (keep banner, controls + layout)
	for _, c in ipairs(pageLive:GetChildren()) do
		if c ~= liveBanner and c ~= liveControls and not c:IsA("UIListLayout") then c:Destroy() end
	end
	local order, total, ok = snapshotActive()
	if not ok then
		liveHeader.Text = "⚠ ActiveEggs folder not found (are you in-game?)"
		return
	end
	liveHeader.Text = string.format("🥚 %d eggs live · %d types  (sorted rarest first)", total, #order)
	for i, g in ipairs(order) do
		local right1 = "x" .. g.count
		local price = g.price and ("$" .. formatBig(g.price)) or "$?"
		local luck = g.luck and ("Luck " .. formatBig(g.luck)) or ""
		local near = (g.nearest ~= math.huge) and string.format(" · %.0fst", g.nearest) or ""
		eggRow(pageLive, i + 1, g.name, g.rarity, right1 .. "  " .. price, luck .. near, function()
			local wok, wres = warpToNearest(g.name)
			if wok then notify("Warped to " .. g.name, rarityColor(g.rarity))
			else notify("Warp failed: " .. tostring(wres), Color3.fromRGB(230, 85, 85)) end
		end)
	end
	if total == 0 then
		mk("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, -4, 0, 40), LayoutOrder = 2,
			Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = COL.sub, Text = "No eggs currently spawned in the map." }, pageLive)
	end
end

--=============================================================== Egg Index page
local function buildIndex()
	local order = {}
	for name, d in pairs(EggData) do table.insert(order, { name = name, d = d }) end
	table.sort(order, function(a, b)
		local ra, rb = rarityRank(a.d.Rarity), rarityRank(b.d.Rarity)
		if ra ~= rb then return ra > rb end
		return (a.d.Luck or 0) > (b.d.Luck or 0)
	end)
	banner(pageIndex, 0, "📖 Egg Index — " .. #order .. " eggs (rarest first)")
	for i, e in ipairs(order) do
		local d = e.d
		local price = d.SellPrice and ("$" .. formatBig(d.SellPrice)) or (d.Premium and "Premium" or "$?")
		local luck = d.Luck and ("Luck " .. formatBig(d.Luck)) or ""
		local growth = "⏱ " .. formatTime(d.GrowthTime)
		local chance = d.AppearChance and (" · " .. tostring(d.AppearChance) .. "%") or ""
		eggRow(pageIndex, i, e.name, d.Rarity or "?", price .. "  " .. growth, luck .. chance)
	end
end

